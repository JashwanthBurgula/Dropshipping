# Application & Brand Configuration
NODE_ENV="development"
# Next.js sets NODE_ENV="production" during `next build`.
# Use DEPLOYMENT_TARGET="local-preview" for local build verification while legal fields are placeholders.
# Use DEPLOYMENT_TARGET="production" in production (also enforced automatically on cloud platforms or non-localhost NEXT_PUBLIC_APP_URL).
DEPLOYMENT_TARGET="local-preview"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Kala & Kiln"
LEGAL_ENTITY_NAME="Kala & Kiln Retail Pvt. Ltd."
NEXT_PUBLIC_SUPPORT_EMAIL="support@kalaandkiln.in"
NEXT_PUBLIC_GRIEVANCE_EMAIL="grievance@kalaandkiln.in"
# Replace the three PLACEHOLDER_ values below before building for production:
GRIEVANCE_OFFICER_NAME="PLACEHOLDER_GRIEVANCE_OFFICER_REPLACE_BEFORE_LAUNCH"
REGISTERED_OFFICE_ADDRESS="PLACEHOLDER_REGISTERED_ADDRESS_REPLACE_BEFORE_LAUNCH"
SELLER_GSTIN="PLACEHOLDER_GSTIN_29AABCK0000X1Z5"
ADMIN_PORTAL_PATH="/ops-portal"
SELLER_STATE_CODE="KA"
SELLER_STATE_NAME="Karnataka"

# Seed Credentials (seed script refuses to run in production; admin requires password change on first login)
INITIAL_ADMIN_EMAIL="admin@kalaandkiln.in"
INITIAL_ADMIN_PASSWORD="REPLACE_BEFORE_LOCAL_USE"
SEED_CUSTOMER_EMAIL="customer@kalaandkiln.in"
SEED_CUSTOMER_PASSWORD="REPLACE_BEFORE_LOCAL_USE"

# Database (PostgreSQL 16) & Cache (Redis 7)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/dropshipping_store?schema=public"
REDIS_URL="redis://localhost:6379"

# Security, Session, CSRF & AES-256-GCM Encryption Key
# ENCRYPTION_KEY_HEX must be a 64-character hex string (32 bytes) for AES-256-GCM
SESSION_SECRET="GENERATE_UNIQUE_64_CHAR_HEX"
CSRF_SECRET="GENERATE_UNIQUE_64_CHAR_HEX"
TOKEN_HASH_PEPPER="GENERATE_UNIQUE_64_CHAR_HEX"
ENCRYPTION_KEY_HEX="GENERATE_UNIQUE_64_HEX_CHARACTERS"
CRON_SECRET="GENERATE_UNIQUE_RANDOM_SECRET"

# Have I Been Pwned Range API Policy ("false" = fail open on external network timeout after local dictionary check)
HIBP_STRICT_FAIL_CLOSED="false"

# Razorpay Payment Gateway (Launch Gateway: Cards, UPI, Netbanking)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="whsec_razorpay_placeholder"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"

# Cash on Delivery (COD) & Shipping Rules
COD_NEW_ACCOUNT_MAX_PAISE="500000"
COD_STANDARD_MAX_PAISE="1500000"
FREE_SHIPPING_THRESHOLD_PAISE="99900"

# Transactional Email ("smtp", "resend", or "console")
# In production, "console" or placeholder credentials will refuse to start.
# To send real OTP emails via Gmail SMTP with a 16-character Google App Password:
#   EMAIL_PROVIDER="smtp"
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_SECURE="false"
#   SMTP_USER="your.address@gmail.com"
#   SMTP_PASS="abcd efgh ijkl mnop"
#   EMAIL_FROM="Kala & Kiln <your.address@gmail.com>"
EMAIL_PROVIDER="console"
EMAIL_FROM="Kala & Kiln <orders@kalaandkiln.in>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="placeholder_user@gmail.com"
SMTP_PASS="placeholder_app_password"
RESEND_API_KEY="re_placeholder"

# Bot Protection (Cloudflare Turnstile - Official Always-Passes Test Keys for Local Dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Allowed Customer Registration Email Domains (comma-separated; "*" permits all domains)
ALLOWED_EMAIL_DOMAINS="gmail.com,googlemail.com"

# Daily Email Send Quota Limit (default 400; 80% logs warning, 95% blocks sends)
EMAIL_DAILY_LIMIT="400"

# Storage Adapter ("local" writes outside /public into .storage/uploads; "s3" or "cloudinary" for production)
STORAGE_PROVIDER="local"
NEXT_PUBLIC_CDN_URL="https://cdn.kalaandkiln.in"
